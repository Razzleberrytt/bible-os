{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bible-os.example/schemas/reference-mapping-observation.schema.json",
  "title": "Bible OS Reference Mapping Observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observation_id",
    "source_system",
    "target_system",
    "source_references",
    "target_references",
    "relation_type",
    "status",
    "confidence",
    "canonical_mapping_status",
    "evidence"
  ],
  "properties": {
    "observation_id": {"type": "string", "pattern": "^obs_[a-z0-9]{12,}$"},
    "source_system": {"type": "string", "minLength": 1},
    "target_system": {"type": "string", "minLength": 1},
    "source_references": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "target_references": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "reference_pairs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_reference", "target_reference", "relation_type"],
        "properties": {
          "source_reference": {"type": "string", "minLength": 1},
          "target_reference": {"type": "string", "minLength": 1},
          "relation_type": {
            "enum": ["equivalent", "split", "join", "overlap", "omitted", "addition", "relocated", "uncertain"]
          }
        }
      }
    },
    "relation_type": {
      "enum": ["equivalent", "split", "join", "overlap", "omitted", "addition", "relocated", "uncertain"]
    },
    "status": {
      "enum": ["machine-observed", "evidence-reviewed", "human-reviewed", "accepted", "rejected"]
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "canonical_mapping_status": {
      "enum": ["pending-passage-identities", "ready-for-review", "materialized", "rejected"]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "canonical_mapping_status": {"const": "materialized"}
        },
        "required": ["canonical_mapping_status"]
      },
      "then": {
        "required": ["reference_pairs"]
      }
    }
  ]
}
