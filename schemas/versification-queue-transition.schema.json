{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bible-os.example/schemas/versification-queue-transition.schema.json",
  "title": "Bible OS Versification Queue Transition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "transition_id",
    "transition_kind",
    "queue_item_id",
    "queue_item_sha256",
    "decision_id",
    "decision_sha256",
    "decision_outcome",
    "from_status",
    "to_status",
    "applied_by",
    "applied_at",
    "record_policy",
    "application_scope",
    "status_effect",
    "queue_document_mutation",
    "effective_status_source",
    "materialization_authority",
    "mapping_execution_authority",
    "corpus_mutation_authority",
    "release_authority",
    "execution_eligible",
    "publication_eligible"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "transition_id": {
      "type": "string",
      "pattern": "^vqt_[a-z0-9]{12,}$"
    },
    "transition_kind": {
      "const": "apply-human-governance-decision"
    },
    "queue_item_id": {
      "type": "string",
      "pattern": "^vrq_[a-z0-9]{12,}$"
    },
    "queue_item_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "decision_id": {
      "type": "string",
      "pattern": "^vrd_[a-z0-9]{12,}$"
    },
    "decision_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "decision_outcome": {
      "enum": ["accepted", "rejected", "needs-evidence", "withdrawn"]
    },
    "from_status": {
      "enum": ["queued", "in-review", "needs-evidence"]
    },
    "to_status": {
      "enum": ["accepted", "rejected", "needs-evidence", "withdrawn"]
    },
    "applied_by": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/humanActor"
      }
    },
    "applied_at": {
      "type": "string",
      "format": "date-time"
    },
    "supersedes_transition_id": {
      "type": ["string", "null"],
      "pattern": "^vqt_[a-z0-9]{12,}$"
    },
    "record_policy": {
      "const": "append-only"
    },
    "application_scope": {
      "const": "queue-governance-status-only"
    },
    "status_effect": {
      "const": "effective-governance-status"
    },
    "queue_document_mutation": {
      "const": "not-performed"
    },
    "effective_status_source": {
      "const": "append-only-transition-event"
    },
    "materialization_authority": {
      "const": "none"
    },
    "mapping_execution_authority": {
      "const": "none"
    },
    "corpus_mutation_authority": {
      "const": "none"
    },
    "release_authority": {
      "const": "none"
    },
    "execution_eligible": {
      "const": false
    },
    "publication_eligible": {
      "const": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"decision_outcome": {"const": "accepted"}},
        "required": ["decision_outcome"]
      },
      "then": {
        "properties": {"to_status": {"const": "accepted"}}
      }
    },
    {
      "if": {
        "properties": {"decision_outcome": {"const": "rejected"}},
        "required": ["decision_outcome"]
      },
      "then": {
        "properties": {"to_status": {"const": "rejected"}}
      }
    },
    {
      "if": {
        "properties": {"decision_outcome": {"const": "needs-evidence"}},
        "required": ["decision_outcome"]
      },
      "then": {
        "properties": {"to_status": {"const": "needs-evidence"}}
      }
    },
    {
      "if": {
        "properties": {"decision_outcome": {"const": "withdrawn"}},
        "required": ["decision_outcome"]
      },
      "then": {
        "properties": {"to_status": {"const": "withdrawn"}}
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "humanActor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "actor_type", "role"],
      "properties": {
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "actor_type": {
          "const": "human"
        },
        "role": {
          "enum": [
            "textual-scholar",
            "data-curator",
            "language-specialist",
            "canon-specialist",
            "engineering-reviewer",
            "governance-operator"
          ]
        },
        "affiliation": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
