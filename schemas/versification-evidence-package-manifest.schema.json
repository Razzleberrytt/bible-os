{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bible-os.example/schemas/versification-evidence-package-manifest.schema.json",
  "title": "Bible OS Versification Evidence Package Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "requirements_id",
    "requirements_sha256",
    "queue_item_id",
    "status",
    "scope",
    "requirement_states",
    "artifacts",
    "completion_summary",
    "created_at",
    "created_by",
    "record_policy",
    "package_semantics",
    "decision_authority",
    "queue_status_authority",
    "materialization_authority",
    "execution_eligible",
    "publication_eligible",
    "source_text_embedded"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "package_id": {
      "type": "string",
      "pattern": "^vep_[a-z0-9]{12,}$"
    },
    "requirements_id": {
      "type": "string",
      "pattern": "^ver_[a-z0-9]{12,}$"
    },
    "requirements_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "queue_item_id": {
      "type": "string",
      "pattern": "^vrq_[a-z0-9]{12,}$"
    },
    "status": {
      "enum": [
        "awaiting-human-evidence",
        "collecting-human-evidence",
        "evidence-ready-for-review"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_references",
        "target_references",
        "excluded_candidate_ids"
      ],
      "properties": {
        "source_references": {
          "$ref": "#/$defs/reference_list"
        },
        "target_references": {
          "$ref": "#/$defs/reference_list"
        },
        "excluded_candidate_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^can_[a-z0-9]{12,}$"
          }
        }
      }
    },
    "requirement_states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement_id",
          "state",
          "artifact_ids"
        ],
        "properties": {
          "requirement_id": {
            "type": "string",
            "pattern": "^req_[a-z0-9]{12,}$"
          },
          "state": {
            "enum": [
              "missing",
              "partial",
              "satisfied-pending-human-validation",
              "human-validated"
            ]
          },
          "artifact_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^epa_[a-z0-9]{12,}$"
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact_reference"
      }
    },
    "completion_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_count",
        "satisfied_requirement_count",
        "human_validated_requirement_count",
        "referenced_artifact_count",
        "review_readiness",
        "approval_implied"
      ],
      "properties": {
        "requirement_count": {
          "type": "integer",
          "minimum": 1
        },
        "satisfied_requirement_count": {
          "type": "integer",
          "minimum": 0
        },
        "human_validated_requirement_count": {
          "type": "integer",
          "minimum": 0
        },
        "referenced_artifact_count": {
          "type": "integer",
          "minimum": 0
        },
        "review_readiness": {
          "enum": [
            "not-ready",
            "evidence-ready-for-review-only"
          ]
        },
        "approval_implied": {
          "const": false
        }
      }
    },
    "supersedes_package_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^vep_[a-z0-9]{12,}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string",
      "minLength": 1
    },
    "record_policy": {
      "const": "append-only"
    },
    "package_semantics": {
      "const": "reference-manifest-only"
    },
    "decision_authority": {
      "const": "none"
    },
    "queue_status_authority": {
      "const": "none"
    },
    "materialization_authority": {
      "const": "none"
    },
    "execution_eligible": {
      "const": false
    },
    "publication_eligible": {
      "const": false
    },
    "source_text_embedded": {
      "const": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "evidence-ready-for-review"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "requirement_states": {
            "items": {
              "properties": {
                "state": {
                  "const": "human-validated"
                }
              },
              "required": [
                "state"
              ]
            }
          },
          "completion_summary": {
            "properties": {
              "review_readiness": {
                "const": "evidence-ready-for-review-only"
              },
              "approval_implied": {
                "const": false
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "completion_summary": {
            "properties": {
              "review_readiness": {
                "const": "not-ready"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reference_list": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z0-9]{3} [0-9]+:[0-9]+$"
      }
    },
    "artifact_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "requirement_ids",
        "artifact_kind",
        "locator",
        "sha256",
        "byte_size",
        "media_type",
        "supplied_by",
        "supplied_at",
        "contains_source_text",
        "retained_in_repository",
        "decision_effect"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^epa_[a-z0-9]{12,}$"
        },
        "requirement_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^req_[a-z0-9]{12,}$"
          }
        },
        "artifact_kind": {
          "enum": [
            "registered-source-locator-index",
            "source-unit-digests",
            "comparison-notes",
            "provenance-citations",
            "scholarly-citations",
            "hypothesis-matrix"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 0
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "citation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "authors"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "authors": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "year": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "persistent_identifier": {
              "type": [
                "string",
                "null"
              ]
            },
            "accessed_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            }
          }
        },
        "supplied_by": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "actor_id",
            "actor_type"
          ],
          "properties": {
            "actor_id": {
              "type": "string",
              "minLength": 1
            },
            "actor_type": {
              "const": "human"
            },
            "affiliation": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "supplied_at": {
          "type": "string",
          "format": "date-time"
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "validated_by",
            "validated_at"
          ],
          "properties": {
            "status": {
              "enum": [
                "unreviewed",
                "human-validated",
                "rejected"
              ]
            },
            "validated_by": {
              "type": [
                "string",
                "null"
              ]
            },
            "validated_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            }
          }
        },
        "contains_source_text": {
          "const": false
        },
        "retained_in_repository": {
          "const": false
        },
        "decision_effect": {
          "const": "none"
        }
      }
    }
  }
}
